{
  "name": "sufra-lite-pos",
  "version": "0.1.29",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-dev.js",
    "dev": "npm-run-all --parallel dev:frontend dev:electron",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:electron": "npm run dev --prefix electron",
    "build:backend": "npm run build:backend --prefix electron",
    "build:frontend": "npm run build --prefix frontend",
    "build:electron": "npm run build --prefix electron",
    "build": "npm-run-all build:backend build:frontend build:electron",
    "dist": "node scripts/run-dist.js"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "systeminformation": "^5.27.11"
  }
}
