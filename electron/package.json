{
  "name": "sufra-lite-electron",
  "version": "0.1.21",
  "private": true,
  "description": "sufra pos",
  "author": "Aman Technology",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/convert-icon.js && npm run build:backend && npm run build && npm run dev:electron",
    "dev:electron": "node scripts/convert-icon.js && node scripts/patch-electron-icon.js && node run-electron.js",
    "dev:platform": "cross-env AMAAN_PLATFORM_URL=http://127.0.0.1:3850 AMAAN_PLATFORM_ENFORCE_UNPACKAGED=1 node scripts/convert-icon.js && node run-electron.js",
    "dev:frontend": "cd ../frontend && npm run dev",
    "dev:all": "concurrently \"npm run dev:frontend\" \"npm run dev\"",
    "dev:watch": "concurrently \"tsc -p tsconfig.json --watch\" \"npx electron .\"",
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node copy-assets.js",
    "build:frontend": "cd ../frontend && npm run build",
    "build:backend": "cd backend && npm run build:clean",
    "build:backend:bundle": "cd backend && node build-bundle.js",
    "ensure-electron-deps": "node scripts/ensure-electron-deps.js",
    "rebuild:native": "npx electron-rebuild -f -w better-sqlite3,bcrypt -m ./backend",
    "dist": "node scripts/dist-with-restore.js",
    "dist:timed": "node scripts/dist-timed.js",
    "start": "npx electron .",
    "create-icon": "node create-icon.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.1.3",
    "canvas": "^3.2.0",
    "electron-updater": "6.8.3",
    "fastify": "^5.9.0",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "jimp": "^1.6.0",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.5.0"
  }
}
